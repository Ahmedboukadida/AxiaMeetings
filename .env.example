# Copy to .env (local) or set in your host's dashboard. Never commit real values.

# Database (PostgreSQL). DIRECT_URL = non-pooled URL used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# Database pool of the Next.js API routes (src/lib/prisma.tsx), one pool per process.
# Total connections per app instance = DB_POOL_MAX + SOCKET_DB_POOL_MAX (server.mjs).
# Keep it under your Postgres max_connections (Neon/pooled hosts: stay small, e.g. 5).
# DB_POOL_MAX=10
# Close idle connections after N ms
# DB_POOL_IDLE_TIMEOUT_MS=30000
# Fail a query after N ms waiting for a connection instead of hanging forever
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# Server-side statement_timeout in ms (0 = off). Leave off with PgBouncer/Neon pooled URLs.
# DB_STATEMENT_TIMEOUT_MS=0
# Max connections of the Socket.IO server's own pg pool (server.mjs, default 5)
# SOCKET_DB_POOL_MAX=5

# Seconds the active AI keys (AI Tokens page) are cached in memory; changes made
# through the AI Tokens page clear the cache at once. 0 = no cache.
# AI_KEYS_CACHE_TTL_SECONDS=30

# Auth
JWT_SECRET=
# Days a PV link emailed to participants stays valid (signed with JWT_SECRET,
# separate from join tokens; works once the meeting is FINISHED). Default 90.
# PV_LINK_TTL_DAYS=90
# Rate limiting / login lockout key = client IP (src/lib/rate-limit.ts getIp).
# false (default): X-Forwarded-For / X-Real-IP are ignored (a client could forge them);
#   the TCP peer address seen by server.mjs is used.
# true: ONLY when the app is reachable exclusively through ONE reverse proxy (nginx,
#   Caddy, Traefik, a PaaS router) that appends the client address to X-Forwarded-For;
#   the right-most X-Forwarded-For entry is then used. Behind a proxy with false, every
#   client shares the proxy's address and therefore one rate-limit bucket.
TRUST_PROXY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3002
PORT=3002

# LiveKit (audio/video)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Redis (optional; leave REDIS_ENABLED=false to use in-memory fallbacks)
REDIS_URL=
REDIS_ENABLED=false

# Seed (only for `npm run seed`)
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_PASSWORD=

# AI model lists (optional, comma-separated, tried in order; empty = built-in defaults
# in src/lib/ai-provider.ts). Update these when a provider retires a model.
# AI_GROQ_MODELS=
# AI_GEMINI_MODELS=
# AI_OPENROUTER_MODELS=
