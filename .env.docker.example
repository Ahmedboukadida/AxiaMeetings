# ─────────────────────────────────────────────────────────────────────────────
# AxiaMeetings - Docker environment template
#
#   Copy-Item .env.docker.example .env.docker     (PowerShell)
#   docker compose --env-file .env.docker up -d --build
#
# .env.docker is git-ignored and docker-ignored. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL runs natively on the Windows host) ─────────────────
# host.docker.internal resolves to the host from inside the containers.
# URL-encode special characters in the password (@ -> %40, # -> %23, ...).
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/axiameetingforall?schema=public
# Optional (least privilege, see docs/db-least-privilege.sql): run migrations with the owner
# account while the app uses the limited axia_app role in DATABASE_URL.
# MIGRATE_DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:5432/axiameetingforall?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
# Long random string, e.g. in PowerShell:
#   [Convert]::ToBase64String([byte[]](1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
# Days a PV link emailed to participants stays valid (signed with JWT_SECRET,
# separate from join tokens; works once the meeting is FINISHED). Default 90.
# PV_LINK_TTL_DAYS=90
# Rate limiting / login lockout key = client IP (src/lib/rate-limit.ts getIp).
# false (default): X-Forwarded-For / X-Real-IP are ignored (a client could forge them);
#   the TCP peer address seen by server.mjs is used.
# true: ONLY when the app is reachable exclusively through ONE reverse proxy (nginx,
#   Caddy, Traefik, a PaaS router) that appends the client address to X-Forwarded-For;
#   the right-most X-Forwarded-For entry is then used. Behind a proxy with false, every
#   client shares the proxy's address and therefore one rate-limit bucket.
TRUST_PROXY=false

# ── Public values (BUILD ARGS) ──────────────────────────────────────────────
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time
# (docker compose passes them as build args) and also read at RUN time by
# the server. They MUST be identical for build and run: after changing one,
# rebuild with `docker compose --env-file .env.docker up -d --build`.
# Put only public, non-secret values here.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Host side of the published port (default 127.0.0.1:3002). If Windows refuses 3002
# ("access a socket in a way forbidden"), pick a free port and update NEXT_PUBLIC_SITE_URL.
# APP_BIND_HOST=127.0.0.1
# APP_HOST_PORT=3002
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud

# ── LiveKit Cloud (server-side secrets, runtime only) ───────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Redis (the `redis` service in docker-compose.yml) ───────────────────────
# Required. Redis runs with --requirepass; docker-compose.yml builds the app's
# REDIS_URL (redis://:REDIS_PASSWORD@redis:6379) from it, so no REDIS_URL here.
# Use letters/digits only (it goes into a URL), e.g.:
#   openssl rand -hex 24
#   PowerShell: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
REDIS_PASSWORD=
REDIS_ENABLED=true

# ── Uploads (persisted in the uploads_data volume) ──────────────────────────
UPLOAD_DIR=/data/uploads

# ── CORS ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL is always allowed. Extra origins, comma-separated,
# e.g. http://192.168.1.10:3002,https://meetings.example.com
CORS_ORIGINS=

# ── Misc ────────────────────────────────────────────────────────────────────
TZ=Africa/Tunis
# Max connections of the Socket.IO server's own pg pool (default 5)
# SOCKET_DB_POOL_MAX=5
# Pool of the Next.js API routes (src/lib/prisma.tsx), one per process.
# Total per app container = DB_POOL_MAX + SOCKET_DB_POOL_MAX (default 10 + 5).
# DB_POOL_MAX=10
# Close idle connections after N ms
# DB_POOL_IDLE_TIMEOUT_MS=30000
# Fail after N ms waiting for a connection instead of hanging forever
# (e.g. Postgres on the Windows host stopped or unreachable)
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# Server-side statement_timeout in ms (0 = off). Safe with the native Postgres,
# e.g. 30000; leave 0 with PgBouncer/Neon pooled URLs.
# DB_STATEMENT_TIMEOUT_MS=0
# Seconds the active AI keys are cached in memory (AI Tokens page edits clear it). 0 = off
# AI_KEYS_CACHE_TTL_SECONDS=30

# ── Seed (only for `npm run seed`) ──────────────────────────────────────────
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_PASSWORD=

# Optional fallback AI keys (runtime keys are managed in the app's AI Tokens page / database)
GEMINI_API_KEY=
GROQ_API_KEY=

# AI model lists (optional, comma-separated, tried in order; empty = built-in defaults
# in src/lib/ai-provider.ts). Update these when a provider retires a model.
# AI_GROQ_MODELS=
# AI_GEMINI_MODELS=
# AI_OPENROUTER_MODELS=
