    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.18.6",
    "livekit-server-sdk": "^2.15.1",
    "lucide-react": "^1.11.0",
    "next": "16.4.0",
    "next-intl": "^4.11.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
