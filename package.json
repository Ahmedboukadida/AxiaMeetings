{
  "name": "axia-meetings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "it": "clear && npx rimraf .next && next build && cross-env NODE_ENV=production PORT=3002 node server.mjs",
    "dev": "node server.mjs",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "prod": "cross-env NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:diff:baseline": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script -o prisma/migrations/0_init/migration.sql"
  },
  "dependencies": {
