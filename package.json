    "@prisma/client": "7.10.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
